# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS so DINX can read your partner's push subscriptions
# in order to notify them. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Web push (optional — the app runs fine without it, just no notifications)
# Generate a pair with:  npm run vapid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# AI features (optional) — statement import fallback + Budget insights
#
# Statement import: only used when the built-in parser cannot read a PDF
# layout. The text is redacted first, then read by Claude Haiku 4.5 (the
# cheapest model — roughly a third of a penny per statement). Leave this
# unset and import still works for CSV, Excel, and any PDF the parser
# understands; unreadable PDFs just report that they could not be read.
#
# Budget: turns your real income/spending numbers into specific recovery
# recommendations, a saving forecast and UK / Isle of Man specific tips, via
# Claude Sonnet. Only called when you tap "Refresh" on the Budget page, and
# cached until you do — leave this unset and Budget still works from its
# rule-based numbers alone, just without the AI-personalised wording.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
