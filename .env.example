# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS so DINX can read your partner's push subscriptions
# in order to notify them. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Web push (optional — the app runs fine without it, just no notifications)
# Generate a pair with:  npm run vapid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Statement import — AI fallback (optional)
#
# Only used when the built-in parser cannot read a PDF layout. The text is
# redacted first, then read by Claude Haiku 4.5 (the cheapest model — roughly
# a third of a penny per statement). Leave this unset and import still works
# for CSV, Excel, and any PDF the parser understands; unreadable PDFs just
# report that they could not be read.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
